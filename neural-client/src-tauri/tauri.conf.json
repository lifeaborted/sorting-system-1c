{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neural-client",
  "version": "0.1.0",
  "identifier": "com.neural-client.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "neural-client",
        "width": 800,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
